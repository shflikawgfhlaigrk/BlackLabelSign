{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bl-sign-private-review",
  "main": "../../src/index.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_ORIGIN": "http://127.0.0.1:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bl-sign-private-review",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "bl-sign-private-review-docs",
      "remote": false
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["sign@blacklabelbots.com"],
      "allowed_destination_addresses": ["bl-sign-synthetic-inbox@example.invalid"],
      "remote": false
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "http"
  }
}
